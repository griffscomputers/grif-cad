# generated artifacts (STL / STEP / G-code)
out/

# per-project folders — everything a part produces stays local; the repo tracks
# only the catalog (projects/index.tsv) + the README explaining the convention.
/projects/*
!/projects/index.tsv
!/projects/README.md

# raw scan data (large, binary)
scans/raw/

# reference images uploaded through the web chat (bridge saves them here;
# NOT under projects/ so previews/catalog never mistake them for renders)
uploads/

# voice: the vendored TTS server (cloned+pinned by voice/setup.sh) and cloned-voice
# reference WAVs (personal-use only — cloned real-person voices never leave this machine)
voice/server/
voice/reference_audio/*.wav

# local config (printer LAN address, bridge subscription token) — keep *.example only
config/*.env
!config/*.env.example
# …except the voice/port wiring, which is deliberately tracked (holds no secrets)
!config/voice.env

# claude code local permission state
.claude/settings.local.json

# python
__pycache__/
*.pyc
.venv/
venv/

# os
.DS_Store

# runtime state (bridge pid + log)
.run/
