# Voice layer wiring — single source of truth (tracked: holds no secrets).
# stack.sh sources this; docker compose consumes it via --env-file.
VOICE_ENABLED=1
VOICE_PORT=8004
VOICE_DEFAULT=jarvis.wav      # filename in voice/reference_audio/
VOICE_BF16=off                # DO NOT enable on MPS: autocast is CUDA-only, so fp32 activations
                              # meet bf16 weights and MPSGraph aborts the process ('mps.add' element
                              # type assertion, torch 2.5.1). Tested 2026-07-04 — see tasks/lessons.md.
WEBUI_PORT=3000               # here so compose is fully env-driven
BRIDGE_PORT=8765

# Where the browser chat lives (see CLAUDE.md "Hub vs standalone"):
#   standalone (default) — this repo runs its OWN Open WebUI container on :WEBUI_PORT.
#                          Forks should stay standalone: zero external dependencies.
#   hub                  — skip the container; only bridge + voice start, and the SHARED
#                          grif-webui-hub cockpit (separate repo, :3001) fronts the same
#                          bridge — pick "grif-cad" in its model picker.
# An exported WEBUI_MODE env var overrides this file, so a shared checkout can do
# `WEBUI_MODE=hub scripts/stack.sh start` without changing the tracked default.
WEBUI_MODE=standalone
HUB_URL=http://localhost:3001 # hub mode: reachability check + the URL printed at start
