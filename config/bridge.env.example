# grif-cad bridge config — copy to config/bridge.env (gitignored) and fill in.

# Subscription auth: mint with `claude setup-token` (one-time, ~1yr) and paste here.
# This rides your Claude plan — do NOT also set ANTHROPIC_API_KEY (that forces metered API billing).
CLAUDE_CODE_OAUTH_TOKEN=

# Model routing. Normal requests use GRIFCAD_MODEL (sonnet — light on plan quota); requests
# that look hard (assemblies, tolerances, gears/threads, complex geometry, CadQuery) auto-
# escalate to GRIFCAD_MODEL_MAX (opus). Set GRIFCAD_AUTOROUTE=0 to always use GRIFCAD_MODEL.
# Saying "use opus" / "use sonnet" in a message forces one for that turn.
GRIFCAD_MODEL=sonnet
GRIFCAD_MODEL_MAX=opus
GRIFCAD_AUTOROUTE=1

# Preferred slicer for the "Open in …" button (orca | creality). BOTH buttons always
# show under each model; this one is just listed first. (Headless slicing always uses
# OrcaSlicer — the only reliably scriptable slicer on macOS.)
SLICER_DEFAULT=orca

# Bridge port on the host.
PORT=8765

# Base URL the BROWSER uses to load rendered preview images. The browser runs on the
# host, so this is localhost (NOT host.docker.internal — that only resolves inside the
# Open WebUI container, which is used for the API connection, configured in Open WebUI:
#   Admin → Settings → Connections → OpenAI →  http://host.docker.internal:8765/v1 )
PUBLIC_BASE=http://localhost:8765
